{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Cream", "color": "#FBF8F3" },
				{ "slug": "base-2", "name": "Linen", "color": "#F2EBE1" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Charcoal", "color": "#1E1B18" },
				{ "slug": "contrast-2", "name": "Graphite", "color": "#4D463F" },
				{ "slug": "primary", "name": "Walnut", "color": "#7A4B2A" },
				{ "slug": "primary-dark", "name": "Dark Walnut", "color": "#56331B" },
				{ "slug": "accent", "name": "Brass", "color": "#C49A5A" },
				{ "slug": "border", "name": "Border", "color": "#E3D9CC" }
			],
			"gradients": [
				{
					"slug": "hero-fade",
					"name": "Hero fade",
					"gradient": "linear-gradient(90deg, rgba(20,17,14,0.88) 0%, rgba(20,17,14,0.55) 55%, rgba(20,17,14,0.15) 100%)"
				},
				{
					"slug": "walnut",
					"name": "Walnut",
					"gradient": "linear-gradient(135deg, #7A4B2A 0%, #56331B 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Fraunces (headings)",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "body",
					"name": "Inter (body)",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "3rem", "fluid": { "min": "2.1rem", "max": "3rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.25rem", "fluid": { "min": "2.6rem", "max": "4.25rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1.25rem" },
				{ "slug": "40", "name": "4", "size": "clamp(1.5rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "5", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3rem, 8vw, 6rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(4rem, 10vw, 8rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "card", "name": "Card", "shadow": "0 1px 2px rgba(30,27,24,0.06), 0 8px 24px rgba(30,27,24,0.08)" },
				{ "slug": "lift", "name": "Lift", "shadow": "0 18px 40px rgba(30,27,24,0.18)" }
			]
		},
		"custom": {
			"radius": "6px",
			"transition": "200ms ease"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|primary-dark" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"border": { "radius": "var:custom|radius" },
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": { "top": "0.9em", "bottom": "0.9em", "left": "1.6em", "right": "1.6em" }
				},
				":hover": {
					"color": { "background": "var:preset|color|primary-dark" }
				},
				":focus": {
					"outline": { "color": "var:preset|color|accent", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var:preset|font-size|x-small" },
				"color": { "text": "var:preset|color|contrast-2" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" }
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": { "text": "currentColor" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "currentColor" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|accent", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "var:preset|spacing|30" } },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontSize": "var:preset|font-size|large" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var:preset|color|border", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "top": "var:preset|spacing|30", "bottom": "var:preset|spacing|30" } }
			},
			"core/image": {
				"border": { "radius": "var:custom|radius" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "cta", "title": "Quote call-to-action", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (no title, full width)", "postTypes": ["page"] },
		{ "name": "page-sidebar-cta", "title": "Page with quote sidebar", "postTypes": ["page", "post"] }
	]
}
